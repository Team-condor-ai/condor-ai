{
  "name": "web-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-sitio.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "test:cartola": "node --experimental-strip-types --test scripts/cartola.test.ts",
    "cf:check": "node scripts/verificar-cloudflare.mjs",
    "cf:deploy": "npm run build && npm run cf:check && wrangler deploy",
    "cf:preview": "npm run build && npm run cf:check && wrangler dev",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:saludo": "node --experimental-strip-types --test src/portal/agentes-ia/saludo.test.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-pdf/renderer": "^4.6.1",
    "@supabase/supabase-js": "^2.112.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wrangler": "^4.125.0"
  }
