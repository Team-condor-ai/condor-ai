# Variables del frontend (Vite). Se cargan en el BUNDLE: nada secreto acá —
# todo lo que lleve el prefijo VITE_ queda visible en el navegador.
# Local: copia este archivo a `.env.local` (está en .gitignore).
# Producción: se setean en Vercel (proyecto web-v2) y hay que redesplegar.

# Landing de campaña /colombia — URL /exec del Web App de Apps Script que
# escribe el lead en Google Sheets. Instrucciones: docs/campana-colombia/Code.gs
# Sin esto, el formulario FALLA a propósito en producción (en dev simula éxito).
VITE_LEADS_API=

# Meta Pixel de la campaña de Colombia (Business Manager → Eventos).
# Sin esto no se carga el Pixel ni la CAPI: la landing funciona, pero la
# campaña queda sin optimización ni atribución.
VITE_META_PIXEL_ID=

# Portal de clientes y staff (/acceso). Opcionales: si no se setean, el
# portal usa la instancia de producción que ya está en el código. Sirven para
# apuntar a otra instancia de Supabase sin recompilar.
# La anon key es PÚBLICA por diseño (la protege RLS, no el secreto).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON=

# ─────────────────────────────────────────────────────────────────────────────
# MODO DEMO DEL PORTAL — solo para desarrollo local
#
# Levanta un Supabase de mentira dentro del propio Vite: se entra con cualquier
# correo y cualquier clave, con datos falsos, sin tocar la base real. Sirve para
# ver el portal sin credenciales.
#
# Para encenderlo, en tu `.env.local` (que NO se sube al repo):
#
#   VITE_PORTAL_DEMO=1
#   VITE_SUPABASE_URL=http://localhost:5173/__demo
#   VITE_SUPABASE_ANON=demo
#
# Y entra con `demo@condorai.cl` (equipo) o `cliente@demo.cl` (cliente).
#
# NO ES UN AGUJERO DE LOGIN: el código que acepta cualquier clave vive en
# `dev/plugin-demo.mjs`, que corre solo con `apply: "serve"`. En un
# `npm run build` ni se carga, así que no existe en el sitio publicado.
# Poner esta variable en producción no hace absolutamente nada.
VITE_PORTAL_DEMO=
