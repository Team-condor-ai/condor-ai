{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "condor-ai-web",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/acceso",
      "/acceso/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
